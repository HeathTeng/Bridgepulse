# 复制本文件为 .env，再填入你在 developer.whoop.com 拿到的值。
# .env 已被 .gitignore 排除，不会上传到 GitHub。
WHOOP_CLIENT_ID=在这里填你的Client_ID
WHOOP_CLIENT_SECRET=在这里填你的Client_Secret
WHOOP_REDIRECT_URI=http://localhost:3000/callback
PORT=3000

# ---------- 接入 AI（可选，不填就不开启）----------
# 填好这三项后，「今日建议」卡片上会出现「AI 帮我写」按钮，只有点了才会请求。
# 接口用 OpenAI 兼容的 /chat/completions 格式，DeepSeek、通义千问、Kimi、智谱、Claude、OpenAI 都能用。
# 发送的只有数字摘要和本地规则建议，不含令牌、姓名、邮箱；数据会发到你填的这家公司，按用量收费。
# AI_BASE_URL：接口地址，到 /chat/completions 之前的部分（末尾不要加 /chat/completions）
# AI_API_KEY：在对应平台申请的密钥，只保存在本机 .env 里，不会发给页面
# AI_MODEL：模型名称
# 例子（DeepSeek）：
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=在这里填你的AI密钥
AI_MODEL=deepseek-chat
